  "caption": "En toda ronda de mate manda una sola persona 🧉 El cebador, el primer mate y el error de decir \"gracias\".\nGuardalo para tu próxima ronda. ¿Vos cebás o esperás? Contalo en los comentarios 👇",
  "hashtags": ["#mate", "#yerbamate", "#argentina", "#cebador", "#matero", "#costumbresargentinas", "#rondademate"],
  "segments": [
    { "text": "Una sola persona manda en la ronda de mate.", "emo": "surprised", "beat": "hook",
      "visual": { "type": "scene", "place": "kitchen", "people": [ { "role": "cebador", "does": "hold_mate" }, { "role": "friend" }, { "role": "grandma" } ], "label": { "text": "EL QUE MANDA", "on": 0 } },
      "headline": "MANDA UNO", "headlineAt": "sola", "impact": true },
    { "text": "Y casi todos rompen su regla sin saberlo.", "emo": "tense", "beat": "loop",
      "visual": { "type": "reaction", "emotion": "surprised", "act": "shock", "color": "red", "who": 1 }, "headline": "SU REGLA", "headlineAt": "regla" },
    { "text": "Se llama cebador, y es el que sirve el mate.", "emo": "warm", "beat": "body",
      "visual": { "type": "scene", "place": "patio", "people": [ { "role": "cebador", "does": "hold_both" } ], "label": { "text": "CEBADOR", "on": 0 } }, "headline": "EL CEBADOR", "headlineAt": "ceba" },
    { "text": "El primer mate se lo toma él, y está amargo.", "emo": "funny", "beat": "body",
      "visual": { "type": "scene", "place": "kitchen", "people": [ { "role": "cebador", "does": "drink", "mood": "sad" } ] }, "headline": "EL PRIMERO ES SUYO", "headlineAt": "primer", "impact": true },
    { "text": "Así el mejor mate te llega a vos.", "emo": "warm", "beat": "body",
      "visual": { "type": "object", "item": "mate", "mascot": "happy" }, "headline": "EL MEJOR, PARA VOS", "headlineAt": "mejor" },
    { "text": "Después lo llena y te lo pasa.", "emo": "warm", "beat": "body",
      "visual": { "type": "scene", "place": "park", "people": [ { "role": "cebador" }, { "role": "friend", "mood": "happy" } ], "pass": [0, 1] }, "headline": "TE LO PASA", "headlineAt": "pasa" },
    { "text": "Pero esperá, acá viene el error más común.", "emo": "excited", "beat": "rehook",
      "visual": { "type": "reaction", "emotion": "surprised", "act": "jump", "color": "purple", "who": 2 }, "headline": "EL ERROR", "headlineAt": "esper", "impact": true },
    { "text": "No digas gracias si querés seguir tomando.", "emo": "tense", "beat": "body",
      "visual": { "type": "mistake", "text": "GRACIAS", "at": "graci", "over": { "type": "scene", "place": "kitchen", "people": [ { "role": "cebador", "does": "hold_termo" }, { "role": "stranger", "does": "no", "mood": "surprised" } ] } } },
    { "text": "Decir gracias significa: ya está, no quiero más.", "emo": "surprised", "beat": "body",
      "visual": { "type": "title", "text": "GRACIAS", "sub": "= YA NO QUIERO MÁS" } },
    { "text": "Y nunca muevas la bombilla, eso es del cebador.", "emo": "funny", "beat": "body",
      "visual": { "type": "object", "item": "mate", "labels": ["BOMBILLA"] }, "headline": "NO LA MUEVAS", "headlineType": "cross", "headlineAt": "muevas" },
    { "text": "Cada mate vuelve siempre a sus manos.", "emo": "nostalgic", "beat": "rehook",
      "visual": { "type": "scene", "place": "plaza", "people": [ { "role": "friend" }, { "role": "cebador", "does": "hold_both", "mood": "happy" }, { "role": "grandma" }, { "role": "stranger" }, { "role": "you" } ], "label": { "text": "CEBADOR", "on": 1 } },
      "headline": "SIEMPRE VUELVE", "headlineAt": "vuelve", "impact": true },
    { "text": "En la plaza, hasta un desconocido te convida.", "emo": "warm", "beat": "body",
      "visual": { "type": "scene", "place": "plaza", "people": [ { "role": "grandpa", "mood": "happy" }, { "role": "you", "mood": "surprised" } ], "pass": [0, 1] }, "headline": "TE CONVIDA", "headlineAt": "convida" },
    { "text": "Porque el cebador no sirve mate: sirve compañía.", "emo": "love", "beat": "payoff",
      "visual": { "type": "scene", "place": "patio", "people": [ { "role": "friend", "does": "hug", "mood": "love" }, { "role": "cebador", "does": "hold_mate", "mood": "happy" }, { "role": "grandma", "does": "hug", "mood": "love" } ] },
      "headline": "COMPAÑÍA", "headlineAt": "compa", "impact": true },
    { "text": "¿Vos cebás o esperás? Seguinos para más.", "emo": "funny", "beat": "cta", "visual": { "type": "title", "text": "" } }
